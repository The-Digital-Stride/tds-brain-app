{
  "about": "Test cases for project codes (shared/project-refs-contract.ts, plan docs/plans/2026-11-24-projects-r2-project-codes.md decision 7). Run by shared/project-refs.test.ts and by the tdsapp-projects script's test, so both implementations follow one rule. Words are maximal runs of A-Z a-z 0-9; a candidate is a word that, upper-cased, fully matches REF_CANDIDATE_SOURCE.",
  "candidates": [
    { "text": "Kick-off [AST4K7] with Astrum", "expect": ["AST4K7"], "why": "brackets are boundaries" },
    { "text": "re: ast4k7 notes", "expect": ["AST4K7"], "why": "any case, upper-cased" },
    { "text": "H2O4K7 review", "expect": ["H2O4K7"], "why": "client code with a digit" },
    { "text": "HN3P8 call", "expect": ["HN3P8"], "why": "two-letter client" },
    { "text": "SWFT7N2 sprint", "expect": ["SWFT7N2"], "why": "four-letter client" },
    { "text": "AST4K7X", "expect": [], "why": "one longer word that doesn't fit" },
    { "text": "XAST4K7", "expect": ["XAST4K7"], "why": "the whole word is the candidate (client XAST), never AST4K7 inside it" },
    { "text": "ZZXAST4K7", "expect": [], "why": "too long: AST4K7 is only part of a word" },
    { "text": "Office SW1A 1AA and SW1A1AA", "expect": [], "why": "postcodes end in letters" },
    { "text": "Flight BA284 at 9", "expect": [], "why": "no middle letter" },
    { "text": "A4K7", "expect": [], "why": "client part shorter than 2" },
    { "text": "AST4K1 and AST4O7", "expect": ["AST4K1", "AST4O7"], "why": "candidates (for did-you-mean) even though neither is a valid ref" },
    { "text": "[AST4K7] [ast4k7] AST4K7", "expect": ["AST4K7"], "why": "de-duplicated after upper-casing" },
    { "text": "SWFT7N2_H2O4K7-AST4K7.pdf", "expect": ["SWFT7N2", "H2O4K7", "AST4K7"], "why": "_ - . are boundaries; order kept" },
    { "text": "ast4k7@example.com", "expect": ["AST4K7"], "why": "@ is a boundary" },
    { "text": "Meeting ID 845 1234 5678 passcode 4k7", "expect": [], "why": "conferencing boilerplate" },
    { "text": "AA2C2 AA2C3 AA2C4 AA2C5 AA2C6 AA2C7", "expect": ["AA2C2", "AA2C3", "AA2C4", "AA2C5", "AA2C6", "AA2C7"], "why": "no cap here: callers cap after lookup" },
    { "text": "", "expect": [], "why": "empty" }
  ],
  "valid": [
    { "ref": "AST4K7", "expect": true },
    { "ref": "H2O4K7", "expect": true },
    { "ref": "H204K7", "expect": true, "why": "shape is valid; it finds H2O4K7 only through folding" },
    { "ref": "SWFT7N2", "expect": true },
    { "ref": "HN3P8", "expect": true },
    { "ref": "R4R2C9", "expect": true },
    { "ref": "AST4K1", "expect": false, "why": "1 not allowed in the project part" },
    { "ref": "AST0K7", "expect": false, "why": "0 not allowed in the project part" },
    { "ref": "AST4O7", "expect": false, "why": "O not in the letter set" },
    { "ref": "AST4B7", "expect": false, "why": "B not in the letter set" },
    { "ref": "ast4k7", "expect": false, "why": "stored refs are upper case" },
    { "ref": "A4K7", "expect": false },
    { "ref": "ABCDE4K7", "expect": false, "why": "client part longer than 4" },
    { "ref": "AST4K7X", "expect": false },
    { "ref": "[AST4K7]", "expect": false, "why": "brackets are never part of a ref" }
  ],
  "foldRef": [
    { "in": "H2O4K7", "out": "H204K7" },
    { "in": "H204K7", "out": "H204K7" },
    { "in": "ast4k7", "out": "AST4K7" },
    { "in": "I1O4K7", "out": "1104K7" },
    { "in": "AST4O7", "out": "AST4O7", "why": "the project part is never folded" },
    { "in": "R4R2C9", "out": "R4R2C9" }
  ],
  "foldClientCode": [
    { "in": "H2O", "out": "H20" },
    { "in": "HO", "out": "H0" },
    { "in": "ast", "out": "AST" },
    { "in": "OI", "out": "01" }
  ],
  "near": [
    { "candidate": "AST4K8", "refs": ["AST4K7", "AST5K7", "GAP4K8"], "expect": ["AST4K7"], "why": "one substitution only" },
    { "candidate": "AST4O7", "refs": ["AST4Q7", "AST4K7"], "expect": ["AST4Q7", "AST4K7"], "why": "order kept" },
    { "candidate": "ATS4K7", "refs": ["AST4K7"], "expect": ["AST4K7"], "why": "two neighbouring characters swapped" },
    { "candidate": "AST4K7", "refs": ["AST4K7", "AST4K8"], "expect": ["AST4K8"], "why": "never the exact ref" },
    { "candidate": "H204K8", "refs": ["H2O4K7"], "expect": ["H2O4K7"], "why": "compared after folding" },
    { "candidate": "ast4k8", "refs": ["AST4K7"], "expect": ["AST4K7"], "why": "candidate upper-cased" },
    { "candidate": "AST4K7", "refs": ["ASTR4K7"], "expect": [], "why": "different length is never near" },
    { "candidate": "AST4K7", "refs": ["AST5K8"], "expect": [], "why": "two substitutions" },
    { "candidate": "AST4K7", "refs": ["A4TSK7"], "expect": [], "why": "a swap of non-neighbours is not near" },
    { "candidate": "AST4K8", "refs": ["AST4K7", "AST4K7"], "expect": ["AST4K7"], "why": "de-duplicated" }
  ]
}
