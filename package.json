{
  "name": "tds-brain-app",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "A local face for the TDS Agency Brain. Internal tool; never published.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.ts",
    "dev": "vite build --watch & node --watch server/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  }
}
