+// Archive a card project through the tdsapp-projects skill: check first (so the page can say how
+// many files move), then archive with the check's own `expect` and `filesExpect`.
+// POST {key, check:true} -> the check; POST {key, filesExpect} -> archives. The key must be one
+// the server's own scan knows. The script's refusal text is passed back as it is.
+app.post('/api/projects/archive-card', express.json({ limit: '8kb' }), (req, res) => {
+  const key = req.body && typeof req.body.key === 'string' ? req.body.key : '';
+  const card = key ? findCardProject(key) : null;
+  if (!card) return res.status(400).json({ error: 'unknown project' });
+  if (!canArchiveCards()) return res.status(501).json({ error: 'This brain cannot archive projects from here yet.' });
+  const refuse = (r) => res.status(r && r.error === 'changed' ? 409 : (r && r.error === 'not-allowed' ? 403 : 422))
+    .json({ error: (r && r.message) || 'The projects script refused.' });
+  const chk = runProjectsScript('archive', { key: card.key, check: true });
